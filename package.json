{
  "name": "dk-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:functions": "tsc -p tsconfig.functions.json --noEmit",
    "auth:migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs npx wrangler d1 migrations apply dk-dashboard-db --local",
    "auth:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/logs npx wrangler d1 migrations apply dk-dashboard-db --remote",
    "auth:verify-schema:local": "WRANGLER_LOG_PATH=.wrangler/logs node --import tsx scripts/auth/verify-schema-local.ts",
    "auth:bootstrap-owner": "WRANGLER_LOG_PATH=.wrangler/logs node --import tsx scripts/auth/bootstrap-owner.ts",
    "auth:reset-owner-password": "WRANGLER_LOG_PATH=.wrangler/logs node --import tsx scripts/auth/reset-owner-password.ts",
    "auth:reset-local": "node --import tsx scripts/auth/reset-local.ts",
    "fixture:refresh": "node --import tsx scripts/fixtures/refresh-fixture.ts",
    "prod:check": "node --import tsx scripts/prod-check/prod-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.6.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.114.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run --passWithNoTests"
    ]
  }
}
